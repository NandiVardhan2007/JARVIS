# ════════════════════════════════════════════════════════════
#  VISION — Environment Configuration
#  Copy this file to .env and fill in your credentials.
#  No OpenAI key required.
# ════════════════════════════════════════════════════════════

# ── LiveKit (required) ────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── AI API Load Balancer (Multi-Provider & Multi-Key Pool) ───
# Strategy options: least_busy | round_robin | latency_based | priority_fallback
VISION_LOAD_BALANCER_STRATEGY=least_busy

# OpenRouter (Comma-separated keys for load balancing or single key)
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Groq (Comma-separated keys or single key)
GROQ_API_KEYS=your_groq_key1,your_groq_key2
GROQ_API_KEY=your_groq_api_key

# NVIDIA NIM (Comma-separated keys or single key)
NVIDIA_API_KEYS=nvapi-key1,nvapi-key2
NVIDIA_API_KEY=your_nvidia_api_key

# Google Gemini API
GEMINI_API_KEYS=your_gemini_key1,your_gemini_key2
GEMINI_API_KEY=your_gemini_api_key

# ── Cartesia (primary TTS) ──────────────────────────────────
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=your_cloned_voice_id

# ── Model overrides (optional) ───────────────────────────────
# LLM
VISION_LLM_MODEL=llama-3.3-70b-versatile
VISION_NIM_LLM_MODEL=meta/llama-3.3-70b-instruct

# STT
VISION_STT_MODEL=whisper-large-v3

# TTS — Groq Orpheus voices: daniel, austin, troy, autumn, diana, hannah
VISION_TTS_VOICE=daniel

# ── Email (optional — for send_email tool) ───────────────────
VISION_EMAIL=your_gmail@gmail.com
VISION_EMAIL_PASSWORD=your_gmail_app_password

# ── YouTube Data API (optional — improves play_media) ────────
YOUTUBE_API_KEY=your_youtube_api_key

# ── IoT — ESP32 bulb IP (optional) ───────────────────────────
VISION_ESP32_IP=10.216.226.11

# ── Screen reader — Gemini Vision (optional) ──────────────────
# Primary vision model for read_screen tool.
# Get key at: https://aistudio.google.com
# Falls back to Groq vision (llama-4-scout) if not set.
GEMINI_API_KEY=your_gemini_api_key

# ── Telegram Bot (optional — for send/read Telegram) ─────────
# 1. Open Telegram → search @BotFather → /newbot
# 2. Copy the token here.
# 3. The recipient must /start your bot first.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ── Discord (optional — choose one or both) ───────────────────
# Option A — Webhook (single channel, no bot needed):
#   Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Option B — Bot token (multi-channel, read + write):
#   https://discord.com/developers/applications → New App → Bot → Reset Token
#   Scopes: bot  |  Permissions: Send Messages, Read Message History
DISCORD_BOT_TOKEN=your_discord_bot_token
TELEGRAM_LLM_API=

# ── GitHub (optional — for github_tool) ──────────────────────
# Generate a Personal Access Token at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token

# ── Sub-Agent LLM Keys (dedicated per agent) ─────────────────
EMAIL_AGENT_LLM_API=your_email_agent_nim_api_key
SCRAPER_AGENT_LLM_API=your_scraper_agent_nim_api_key

# ── Local XTTSv2 Server URL (Emotive Voice API) ─────────────
# Spin up xtts-api-server in Docker or Python on port 8020
XTTS_SERVER_URL=http://localhost:8020/tts

