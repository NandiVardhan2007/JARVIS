# ════════════════════════════════════════════════════════════
#  VISION — STANDALONE ENVIRONMENT TEMPLATE (.env.example)
# ════════════════════════════════════════════════════════════

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

GROQ_API_KEY=your_groq_api_key
GROQ_API_KEYS=key1,key2,key3

# ── TTS Voice Selection (Cartesia Sonic-2 Neural Voice) ────────
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_API_KEYS=key1,key2,key3
CARTESIA_VOICE_ID=1259b7e3-cb8a-43df-9446-30971a46b8b0
CARTESIA_SPEED=normal
CARTESIA_MODEL_ID=sonic-2


NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_API_KEYS=key1,key2,key3

VISION_LOAD_BALANCER_STRATEGY=least_busy
OPENROUTER_API_KEYS=key1,key2,key3
OPENROUTER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct

VISION_LLM_MODEL=llama-3.3-70b-versatile
VISION_NIM_LLM_MODEL=meta/llama-3.1-8b-instruct
VISION_STT_MODEL=whisper-large-v3-turbo

VISION_EMAIL=your_email@gmail.com
VISION_EMAIL_PASSWORD=your_app_password

GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_key
GITHUB_TOKEN=your_github_token

EMAIL_AGENT_LLM_API=your_email_agent_nim_key
SCRAPER_AGENT_LLM_API=your_scraper_agent_nim_key

VISION_PHONE_IP=192.168.1.3
VISION_PHONE_PORT=42381
VISION_PHONE_PATTERN=257368419
ADB_PATH=adb

VISION_VOICE_AUTH_ENABLED=false
VISION_VOICE_AUTH_THRESHOLD=0.75
